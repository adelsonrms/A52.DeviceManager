<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Infra Hub · Design System (Tema Vivid D39 - @infra/ui/styles.css) -->

    <!-- Primary: hsl(17 91% 45%) Light / hsl(18 100% 58%) Dark -->
    <Color x:Key="PrimaryLight">#DC3B0A</Color>
    <Color x:Key="PrimaryDark">#FF5E29</Color>
    <Color x:Key="PrimaryFgLight">#FFFFFF</Color>
    <Color x:Key="PrimaryFgDark">#1A0700</Color>
    <Color x:Key="PrimaryTintLight">#FDECE6</Color>
    <Color x:Key="PrimaryTintDark">#2B1610</Color>

    <!-- Accent: hsl(220 76% 50%) Light / hsl(218 100% 65%) Dark -->
    <Color x:Key="AccentLight">#1F66E0</Color>
    <Color x:Key="AccentDark">#4D88FF</Color>

    <!-- Background: Suavizado para grafite/carvão em vez de preto puro -->
    <Color x:Key="BackgroundLight">#F5F6FA</Color>
    <Color x:Key="BackgroundDark">#16181E</Color>

    <!-- Card / Surface: Superfície elegante com contraste suave -->
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#21232B</Color>

    <!-- Sidebar / TopBar -->
    <Color x:Key="SidebarLight">#FFFFFF</Color>
    <Color x:Key="SidebarDark">#1B1D24</Color>

    <!-- Foreground: hsl(228 41% 7%) Light / hsl(210 20% 98%) Dark -->
    <Color x:Key="ForegroundLight">#0A0D1A</Color>
    <Color x:Key="ForegroundDark">#F8FAFC</Color>

    <!-- Muted / Secondary -->
    <Color x:Key="SecondaryLight">#ECEEF4</Color>
    <Color x:Key="SecondaryDark">#2C2F3A</Color>
    <Color x:Key="MutedBoxLight">#F2F4F8</Color>
    <Color x:Key="MutedBoxDark">#282A34</Color>

    <!-- Muted Foreground: hsl(226 17% 35%) Light / hsl(220 6% 70%) Dark -->
    <Color x:Key="MutedFgLight">#4A5068</Color>
    <Color x:Key="MutedFgDark">#AEB2BA</Color>

    <!-- Border & Input -->
    <Color x:Key="BorderLight">#DBE0EC</Color>
    <Color x:Key="BorderDark">#383C48</Color>
    <Color x:Key="InputLight">#CFD6E6</Color>
    <Color x:Key="InputDark">#3A3E4E</Color>

    <!-- Operational Status Tokens (Success, Warning, Destructive, Info, Violet, Terminal) -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessTextLight">#057A55</Color>
    <Color x:Key="SuccessTextDark">#2EE59D</Color>
    <Color x:Key="SuccessLight">#E6F4EF</Color>
    <Color x:Key="SuccessDark">#11221C</Color>

    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerTextLight">#CE123E</Color>
    <Color x:Key="DangerTextDark">#FF4D6D</Color>
    <Color x:Key="DangerBgLight">#FCE8EC</Color>
    <Color x:Key="DangerBgDark">#281419</Color>

    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningTextLight">#A35C00</Color>
    <Color x:Key="WarningTextDark">#FFBD3D</Color>
    <Color x:Key="WarningBgLight">#FDF3E7</Color>
    <Color x:Key="WarningBgDark">#261F12</Color>

    <Color x:Key="InfoTextLight">#0375B4</Color>
    <Color x:Key="InfoTextDark">#38D9F5</Color>
    <Color x:Key="InfoBgLight">#E6F3FA</Color>
    <Color x:Key="InfoBgDark">#112328</Color>

    <Color x:Key="TerminalBg">#090A0B</Color>
    <Color x:Key="TerminalFg">#F2F4F8</Color>

    <Color x:Key="TagIndigo">#4D88FF</Color>
    <Color x:Key="TagBlue">#38D9F5</Color>
    <Color x:Key="TagGreen">#2EE59D</Color>
    <Color x:Key="TagOrange">#FF5E29</Color>
    <Color x:Key="TagPink">#FF4D6D</Color>
    <Color x:Key="TagPurple">#A389FA</Color>

    <!-- Legacy & MAUI Default Aliases -->
    <Color x:Key="Primary">#DC3B0A</Color>
    <Color x:Key="PrimaryDarkText">#1A0700</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#16181E</Color>
    <Color x:Key="FrameBackgroundLight">#FFFFFF</Color>
    <Color x:Key="FrameBackgroundDark">#21232B</Color>
    <Color x:Key="TextSecondaryLight">#4A5068</Color>
    <Color x:Key="TextSecondaryDark">#AEB2BA</Color>
    <Color x:Key="WarningBackgroundLight">#FDF3E7</Color>
    <Color x:Key="WarningBackgroundDark">#261F12</Color>
    <Color x:Key="Tertiary">#FF5E29</Color>
    <Color x:Key="Secondary">#242629</Color>
    <Color x:Key="SecondaryDarkText">#FF5E29</Color>

    <Color x:Key="Gray100">#ECEEF4</Color>
    <Color x:Key="Gray200">#DBE0EC</Color>
    <Color x:Key="Gray300">#AEB2BA</Color>
    <Color x:Key="Gray400">#AEB2BA</Color>
    <Color x:Key="Gray500">#4A5068</Color>
    <Color x:Key="Gray600">#303236</Color>
    <Color x:Key="Gray900">#18191B</Color>
    <Color x:Key="Gray950">#0C0D0E</Color>

    <Color x:Key="HeaderBackgroundLight">#FFFFFF</Color>
    <Color x:Key="HeaderBackgroundDark">#111213</Color>

    <Color x:Key="MidnightBlue">#0A0D1A</Color>
    <Color x:Key="Magenta">#FF5E29</Color>

</ResourceDictionary>
