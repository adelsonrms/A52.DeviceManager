<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:A52.DeviceManager.Views"
             xmlns:vm="clr-namespace:A52.DeviceManager.ViewModels"
             x:Class="A52.DeviceManager.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header Unificado do Hub -->
        <views:HeaderView Grid.Row="0" Title="A52 Hardware Dashboard" />

        <!-- Conteúdo Compacto -->
        <ScrollView Grid.Row="1" Padding="14,10">
            <VerticalStackLayout Spacing="10" MaximumWidthRequest="560">

                <!-- Barra de Status e Seletor de Dispositivo -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeShape="RoundRectangle 3"
                        Padding="12,8">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                        <!-- Linha 1: Indicador + Seletor/Nome + Botão Atualizar -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="2"
                                     Color="{Binding ConnectionDotColor}"
                                     VerticalOptions="Center" />

                            <!-- Windows: Picker compacto -->
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding AvailableDevices}"
                                    SelectedItem="{Binding SelectedDevice}"
                                    Title="Selecionar dispositivo ADB"
                                    FontSize="12" FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                    TitleColor="{StaticResource MutedFgDark}"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsWindows}" />

                            <!-- Mobile: Nome fixo -->
                            <Label Grid.Column="1"
                                   Text="{Binding Telemetry.DeviceSerial}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   IsVisible="{Binding IsMobile}" />

                            <!-- Ações Rápidas: Atualizar (ícone compacto) e Alternar Tema -->
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                                <Button Text="↻"
                                        Command="{Binding RefreshCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                        BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                        BorderWidth="1"
                                        CornerRadius="2"
                                        HeightRequest="24" WidthRequest="24" Padding="0"
                                        FontSize="13" FontAttributes="Bold"
                                        ToolTipProperties.Text="Atualizar telemetria"
                                        VerticalOptions="Center" />

                                <Button Text="{Binding ThemeIcon}"
                                        Command="{Binding ToggleThemeCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                        BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                        BorderWidth="1"
                                        CornerRadius="2"
                                        HeightRequest="24" WidthRequest="24" Padding="0"
                                        FontSize="12"
                                        ToolTipProperties.Text="Alternar Tema Claro/Escuro"
                                        VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Linha 2: Uptime discreto em linha própria -->
                        <Label Grid.Row="1"
                               Text="{Binding Telemetry.Uptime, StringFormat='Atividade: {0}'}"
                               FontSize="10"
                               TextColor="{StaticResource MutedFgDark}"
                               LineBreakMode="TailTruncation"
                               Margin="16,0,0,0" />
                    </Grid>
                </Border>

                <!-- Status dos Subsistemas (Biometria e Touch) em Linha Única -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <!-- Card Bio (Clicável para Reinício Rápido se Travada) -->
                    <Border Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Stroke="{Binding BioBadgeColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 3"
                            Padding="10,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BiometricCardTappedCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="BIOMETRIA (FOD)" FontSize="10" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedFgLight}, Dark={StaticResource MutedFgDark}}" />
                                <Label Grid.Column="1" Text="REINICIAR ❯" FontSize="9" FontAttributes="Bold"
                                       TextColor="{Binding BioBadgeColor}"
                                       IsVisible="{Binding Telemetry.IsBiometricLocked}" />
                            </Grid>
                            <Label Text="{Binding Telemetry.BiometricStatusText}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding BioBadgeColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Card Touch -->
                    <Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Stroke="{Binding TouchBadgeColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 3"
                            Padding="10,8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="PAINEL TOUCH" FontSize="10" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource MutedFgLight}, Dark={StaticResource MutedFgDark}}" />
                            <Label Text="{Binding Telemetry.TouchStatusText}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{Binding TouchBadgeColor}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Sensor Capacitivo FOD (Simplificado) -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeShape="RoundRectangle 3"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="SENSOR CAPACITIVO FOD"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
                            <Label Grid.Column="1" Text="Referência: Nó 5 ≥ 5"
                                   FontSize="10" TextColor="{StaticResource MutedFgDark}" />
                        </Grid>

                        <!-- Indicador Central com Status Saudável ou Alerta -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="Nó 5 (Centro FOD):" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                   VerticalOptions="Center" />
                            <Border BackgroundColor="{Binding Node5BadgeColor}"
                                    StrokeShape="RoundRectangle 2"
                                    Padding="12,4"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Node5StatusText}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Rótulo Discreto com os Valores Completos -->
                        <VerticalStackLayout Spacing="2" Margin="0,2,0,0">
                            <Label Text="cat /sys/class/sec/tsp/sensitivity_mode:"
                                   FontSize="9" FontAttributes="Bold"
                                   TextColor="{StaticResource MutedFgDark}" />
                            <Label Text="{Binding Telemetry.RawFodNodes}"
                                   FontSize="10"
                                   FontFamily="Consolas, Courier New, monospace"
                                   TextColor="{StaticResource MutedFgDark}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Métricas Compactas em 4 Caixas -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 3" Padding="8,6">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="RUÍDO TNOI" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource MutedFgDark}" />
                            <Label Text="{Binding Telemetry.Tnoi}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ForegroundDark}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 3" Padding="8,6">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="FANTASMAS" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource MutedFgDark}" />
                            <Label Text="{Binding Telemetry.Tmul}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ForegroundDark}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 3" Padding="8,6">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="UMIDADE" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource MutedFgDark}" />
                            <Label Text="{Binding Telemetry.Twet}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ForegroundDark}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 3" Padding="8,6">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="SCRUB POS" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource MutedFgDark}" />
                            <Label Text="{Binding Telemetry.LastScrubPos}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource ForegroundDark}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Ações de Manutenção - Estilo Exato dos Botões do Hub -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeShape="RoundRectangle 3"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="AÇÕES DE MANUTENÇÃO"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <!-- Destravar Touch -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Text="Destravar Touch"
                                    Command="{Binding UnlockTouchCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    BorderWidth="1"
                                    CornerRadius="3"
                                    FontSize="11" FontAttributes="Bold"
                                    HeightRequest="42" Padding="4,0" Margin="0"
                                    HorizontalOptions="Fill" VerticalOptions="Fill" />

                            <!-- Ciclar Tela -->
                            <Button Grid.Row="0" Grid.Column="1"
                                    Text="Ciclar Tela (Off/On)"
                                    Command="{Binding CycleScreenCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    BorderWidth="1"
                                    CornerRadius="3"
                                    FontSize="11"
                                    HeightRequest="42" Padding="4,0" Margin="0"
                                    HorizontalOptions="Fill" VerticalOptions="Fill" />

                            <!-- Reaplicar Blindagem ADB -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Text="Reaplicar Blindagem"
                                    Command="{Binding ApplyHardeningCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    BorderWidth="1"
                                    CornerRadius="3"
                                    FontSize="11"
                                    HeightRequest="42" Padding="4,0" Margin="0"
                                    HorizontalOptions="Fill" VerticalOptions="Fill" />

                            <!-- Reiniciar Celular -->
                            <Button Grid.Row="1" Grid.Column="1"
                                    Text="Reiniciar Celular"
                                    Command="{Binding RebootCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    TextColor="{StaticResource PrimaryFgLight}"
                                    CornerRadius="3"
                                    FontSize="11" FontAttributes="Bold"
                                    HeightRequest="42" Padding="4,0" Margin="0"
                                    HorizontalOptions="Fill" VerticalOptions="Fill" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Feedback / Status Line -->
                <Label Text="{Binding StatusMessage}"
                       HorizontalOptions="Center"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource MutedFgLight}, Dark={StaticResource MutedFgDark}}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
