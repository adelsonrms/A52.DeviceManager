<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="A52.DeviceManager.Views.HeaderView"
             x:Name="ThisHeader">
    <VerticalStackLayout Spacing="0">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource SidebarDark}}"
                StrokeThickness="0"
                Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeShape="RoundRectangle 4"
                        StrokeThickness="1"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center">
                    <Image Source="logo_d.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Dispositivo"
                               FontAttributes="Bold"
                               FontSize="10"
                               CharacterSpacing="1.2"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="•"
                               FontAttributes="Bold"
                               FontSize="10"
                               TextColor="{AppThemeBinding Light={StaticResource MutedFgLight}, Dark={StaticResource MutedFgDark}}" />
                        <Label Text="HARDWARE MONITOR"
                               FontSize="10"
                               CharacterSpacing="0.8"
                               TextColor="{AppThemeBinding Light={StaticResource MutedFgLight}, Dark={StaticResource MutedFgDark}}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Source={x:Reference ThisHeader}, Path=Title}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}" />
                </VerticalStackLayout>

                <!-- Botão de Alternância de Tema Claro / Escuro -->
                <Button Grid.Column="2"
                        x:Name="ThemeToggleButton"
                        Clicked="OnThemeToggleClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ForegroundLight}, Dark={StaticResource ForegroundDark}}"
                        BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BorderWidth="1"
                        CornerRadius="3"
                        WidthRequest="28"
                        HeightRequest="28"
                        Padding="0"
                        FontSize="13"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Alternar Tema Claro/Escuro" />
            </Grid>
        </Border>
        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
    </VerticalStackLayout>
</ContentView>
